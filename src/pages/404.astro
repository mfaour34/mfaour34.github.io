---
import Base from '../layouts/Base.astro';
---

<Base title="Lost" description="This page went to the wrong bay.">
	<section class="section">
		<div class="wrap lost">
			<span class="big" aria-hidden="true">🚗💨</span>
			<h1>404: wrong <em>bay</em>.</h1>
			<p class="muted">This page was routed to the workshop and never came back. Even my agents couldn't find it.</p>
			<a class="btn primary" href="/">Back to the lot</a>
		</div>
	</section>
</Base>

<style>
	.lost {
		text-align: center;
		padding: 40px 20px;
	}
	.big {
		font-size: 80px;
		display: block;
	}
	h1 {
		font-size: clamp(44px, 9vw, 96px);
		font-weight: 800;
		margin: 10px 0 16px;
	}
	h1 em {
		font-style: normal;
		color: var(--accent);
	}
	p {
		font-size: 19px;
		margin-bottom: 28px;
	}
</style>
