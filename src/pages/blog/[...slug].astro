---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { readingTime } from '../../utils';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { slug: post.id }, props: post }));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={post.data.title} description={post.data.description} type="article">
	<article class="section">
		<div class="wrap narrow">
			<a class="back mono" href="/blog/">← all posts</a>
			<header>
				<div class="meta mono">
					<time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
					<span>· {readingTime(post.body ?? '')} min read</span>
					{post.data.updatedDate && <span>· updated {fmt(post.data.updatedDate)}</span>}
				</div>
				<h1>{post.data.title}</h1>
				<p class="desc">{post.data.description}</p>
				{
					post.data.tags.length > 0 && (
						<div class="tags">
							{post.data.tags.map((t) => (
								<span class="tag mono">#{t}</span>
							))}
						</div>
					)
				}
			</header>
			<div class="prose">
				<Content />
			</div>
			<footer class="post-foot card">
				<img src="/assets/avatar.png" alt="" width="56" height="56" />
				<p>
					<b>Written by Mohammed Faour</b>, a product engineer in Munich. Thoughts or disagreements?{' '}
					<a href="mailto:faour606@gmail.com">Email me</a>.
				</p>
			</footer>
		</div>
	</article>
</Base>

<style>
	.back {
		display: inline-block;
		font-size: 14px;
		text-decoration: none;
		margin-bottom: 28px;
		border: 2px solid var(--ink);
		border-radius: 8px;
		padding: 6px 10px;
		background: var(--card);
	}
	.back:hover {
		background: var(--yellow);
		color: #151312;
	}
	.meta {
		font-size: 13px;
		color: var(--muted);
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-bottom: 14px;
	}
	h1 {
		font-size: clamp(38px, 6.5vw, 64px);
		font-weight: 800;
		margin-bottom: 16px;
	}
	.desc {
		font-size: 20px;
		color: var(--muted);
	}
	.tags {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
	}
	.tag {
		font-size: 12px;
		background: var(--yellow);
		color: #151312;
		border: 1.5px solid var(--ink);
		border-radius: 6px;
		padding: 2px 7px;
	}
	header {
		padding-bottom: 28px;
		margin-bottom: 36px;
		border-bottom: 2px dashed var(--ink);
	}

	.prose {
		font-size: 18px;
		line-height: 1.75;
	}
	.prose :global(h2) {
		font-size: 32px;
		margin: 48px 0 14px;
	}
	.prose :global(h3) {
		font-size: 24px;
		margin: 36px 0 10px;
	}
	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1.2em;
	}
	.prose :global(li) {
		margin-bottom: 0.4em;
	}
	.prose :global(li::marker) {
		color: var(--accent);
	}
	.prose :global(a) {
		text-decoration-color: var(--accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
		font-weight: 600;
	}
	.prose :global(blockquote) {
		margin: 1.5em 0;
		padding: 14px 20px;
		background: var(--card);
		border: 2px solid var(--ink);
		border-left: 8px solid var(--accent);
		border-radius: 10px;
	}
	.prose :global(blockquote p:last-child) {
		margin: 0;
	}
	.prose :global(:not(pre) > code) {
		font: 0.88em var(--font-mono);
		background: var(--card);
		border: 1.5px solid var(--ink);
		border-radius: 6px;
		padding: 1px 6px;
	}
	.prose :global(pre) {
		font: 14px/1.6 var(--font-mono);
		padding: 18px 20px;
		border: 2px solid var(--ink);
		border-radius: 12px;
		box-shadow: var(--shadow);
		overflow-x: auto;
		margin: 1.5em 0;
	}
	.prose :global(img) {
		border: 2px solid var(--ink);
		border-radius: 12px;
		box-shadow: var(--shadow);
	}
	.prose :global(hr) {
		border: none;
		border-top: 2px dashed var(--ink);
		margin: 2.5em 0;
	}
	.prose :global(table) {
		border-collapse: collapse;
		width: 100%;
		font-size: 16px;
		margin: 1.5em 0;
	}
	.prose :global(th),
	.prose :global(td) {
		border: 1.5px solid var(--ink);
		padding: 8px 12px;
		text-align: left;
	}
	.prose :global(th) {
		background: var(--yellow);
		color: #151312;
	}
	.post-foot {
		display: flex;
		gap: 16px;
		align-items: center;
		padding: 18px 20px;
		margin-top: 56px;
	}
	.post-foot img {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		border: 2px solid var(--ink);
		flex: none;
	}
	.post-foot p {
		margin: 0;
		font-size: 15px;
	}
</style>

<style is:global>
	/* Shiki dual themes: follow the site theme. */
	:root[data-theme='dark'] .astro-code,
	:root[data-theme='dark'] .astro-code span {
		color: var(--shiki-dark) !important;
		background-color: var(--shiki-dark-bg) !important;
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) .astro-code,
		:root:not([data-theme='light']) .astro-code span {
			color: var(--shiki-dark) !important;
			background-color: var(--shiki-dark-bg) !important;
		}
	}
</style>
