---
const bays = [
	{ key: 'plan', icon: '📝', label: 'Plan', hint: 'write the PRD · 1 slot', slots: 1 },
	{ key: 'build', icon: '🤖', label: 'Agents', hint: 'build in parallel · 3 slots', slots: 3 },
	{ key: 'review', icon: '🔍', label: 'Review', hint: 'just you · 1 slot', slots: 1 },
	{ key: 'deliver', icon: '🚀', label: 'Ship', hint: 'reviewed work only', slots: 0 },
];
---

<div class="dispatch card" data-dispatch>
	<div class="hud">
		<span class="clock">
			<b data-clock>08:00</b>
			<span class="shift-bar" aria-hidden="true"><span data-shift-fill></span></span>
		</span>
		<span>Score <b data-score>0</b></span>
		<span>Combo <b data-combo>×1</b></span>
		<span class="lives" data-lives aria-label="Lives">❤️❤️❤️</span>
		<span>Best <b data-best>0</b></span>
	</div>

	<div class="board">
		<div class="lot">
			<div class="lot-head mono">Ops backlog <span data-lot-count>0/6</span></div>
			<ol class="cars" data-cars aria-live="polite"></ol>
		</div>
		<div class="routes" role="group" aria-label="Destinations">
			{
				bays.map((b, i) => (
					<button class:list={['route', { deliver: b.key === 'deliver' }]} type="button" data-route={b.key}>
						<span class="route-key mono">{i + 1}</span>
						<span class="route-icon" aria-hidden="true">{b.icon}</span>
						<span class="route-label">{b.label}</span>
						<span class="route-hint mono">{b.hint}</span>
						{b.slots > 0 && (
							<span class="slots" data-slots>
								{Array.from({ length: b.slots }, () => (
									<span class="slot">
										<span class="slot-fill" />
									</span>
								))}
							</span>
						)}
					</button>
				))
			}
		</div>
	</div>

	<div class="banner" data-banner hidden></div>

	<div class="overlay" data-overlay>
		<div class="overlay-box">
			<h3 data-overlay-title>Ship it</h3>
			<div data-overlay-body>
				<p>
					One day on the tech side of operations, squeezed into <b>15 seconds</b>. Ops sends bugs 🐛, feature requests ✨, ideas 💡 and the
					odd incident 🔥. Take each ticket through its steps in order (plan, let the agents build, review), then <b>ship</b> it. Agents
					run in parallel. Review is just you.
				</p>
				<p>
					Click a ticket, then a step. Or use <kbd>↑</kbd><kbd>↓</kbd> and <kbd>1</kbd>–<kbd>4</kbd>. A ticket left waiting too
					long gets escalated, and so does a full backlog. Each one costs a ❤️.
				</p>
			</div>
			<button class="btn primary" type="button" data-start>Start the day ▶</button>
		</div>
	</div>
</div>

<script>
	type Job = 'plan' | 'build' | 'review';
	type Kind = Job | 'deliver';
	type Car = {
		id: number;
		jobs: Job[];
		total: number;
		vip: boolean;
		plate: string;
		patience: number;
		max: number;
		el: HTMLLIElement;
	};
	type Bay = { kind: Job; slots: { car: Car; left: number }[]; size: number; time: number; el: HTMLElement };

	const JOBS: Record<Job, { badge: string; label: string }> = {
		plan: { badge: '📝', label: 'Plan' },
		build: { badge: '🤖', label: 'Build' },
		review: { badge: '🔍', label: 'Review' },
	};
	const ORDER: Kind[] = ['plan', 'build', 'review', 'deliver'];
	const TICKETS = {
		bug: { icon: '🐛', jobs: ['build', 'review'] as Job[], titles: ['Driver app crash on handover', 'Relocation ETA off by a day', 'Duplicate pickup in schedule', 'Capacity view times out', 'Webhook retry loop', 'Wrong timezone on slots'] },
		feature: { icon: '✨', jobs: ['plan', 'build', 'review'] as Job[], titles: ['Multi-stop routes', 'Bulk-reschedule moves', 'Driver shift swaps', 'Capacity forecast', 'Slack alerts for delays', 'Self-serve rebooking'] },
		idea: { icon: '💡', jobs: ['plan'] as Job[], titles: ['PRD: auto-assign drivers', 'PRD: site transfer flow', 'PRD: damage photos', 'PRD: return windows'] },
		incident: { icon: '🔥', jobs: ['build', 'review'] as Job[], titles: ['Prod: deliveries stuck', 'Prod: queue backed up', 'Prod: sync job failing'] },
	};
	const COLORS = ['#ff4f1f', '#3d5afe', '#19b46b', '#ffd43b', '#ff8fc8', '#151312', '#e8e2d6'];
	const CAPACITY = 6;
	const SHIFT_MS = 15_000;
	const START_HOUR = 8;
	const HOURS = 10;
	const BAY_TIME: Record<Job, number> = { plan: 900, build: 1200, review: 500 };
	const EVENTS = [
		{ at: 15, text: '⏰ Code freeze soon!' },
	];
	const STARS = [100, 250, 450];

	const root = document.querySelector<HTMLElement>('[data-dispatch]');
	if (root) {
		const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
		const list = $<HTMLOListElement>('[data-cars]');
		const overlay = $('[data-overlay]');
		const banner = $('[data-banner]');
		const scoreEl = $('[data-score]');
		const comboEl = $('[data-combo]');
		const livesEl = $('[data-lives]');
		const bestEl = $('[data-best]');
		const clockEl = $('[data-clock]');
		const shiftFill = $('[data-shift-fill]');
		const lotCount = $('[data-lot-count]');

		const bays = {} as Record<Job, Bay>;
		(['plan', 'build', 'review'] as Job[]).forEach((k) => {
			const el = $(`[data-route="${k}"]`);
			bays[k] = { kind: k, slots: [], size: el.querySelectorAll('.slot').length, time: BAY_TIME[k], el };
		});

		let lot: Car[] = [];
		let selected: number | null = null;
		let score = 0;
		let combo = 1;
		let lives = 3;
		let best = 0;
		let playing = false;
		let visible = true;
		let elapsed = 0;
		let lastTick = 0;
		let spawnIn = 0;
		let nextId = 1;
		let eventIdx = 0;
		let stats = { delivered: 0, missed: 0, mistakes: 0, bestCombo: 1 };

		try {
			best = Number(localStorage.getItem('shipit-best') || 0);
		} catch (e) {}
		bestEl.textContent = String(best);

		const hour = () => START_HOUR + (HOURS * elapsed) / SHIFT_MS;
		const fmtClock = (h: number) => {
			const m = Math.floor((h % 1) * 60);
			return `${String(Math.floor(h)).padStart(2, '0')}:${String(m - (m % 5)).padStart(2, '0')}`;
		};
		const pick = <T,>(a: T[]) => a[Math.floor(Math.random() * a.length)];
		const plate = () => `MOVE-${100 + Math.floor(Math.random() * 900)}`;

		const hud = () => {
			scoreEl.textContent = String(score);
			comboEl.textContent = `×${combo}`;
			livesEl.textContent = '❤️'.repeat(lives) + '🖤'.repeat(3 - lives);
			lotCount.textContent = `${lot.length}/${CAPACITY}`;
			lotCount.classList.toggle('full', lot.length >= CAPACITY - 1);
		};

		const toast = (text: string, kind: 'good' | 'bad') => {
			const t = document.createElement('div');
			t.className = `toast ${kind}`;
			t.textContent = text;
			root.appendChild(t);
			setTimeout(() => t.remove(), 900);
		};

		const showBanner = (text: string) => {
			banner.textContent = text;
			banner.hidden = false;
			banner.classList.remove('show');
			void banner.offsetWidth;
			banner.classList.add('show');
		};

		const flash = (el: HTMLElement | null, cls: 'flash-good' | 'flash-bad') => {
			if (!el) return;
			el.classList.remove('flash-good', 'flash-bad');
			void el.offsetWidth;
			el.classList.add(cls);
		};

		const select = (id: number | null) => {
			if (id === null || !lot.some((c) => c.id === id)) {
				// Default to the ticket closest to being escalated.
				const urgent = [...lot].sort((a, b) => a.patience / a.max - b.patience / b.max)[0];
				id = urgent?.id ?? null;
			}
			selected = id;
			lot.forEach((c) => c.el.classList.toggle('selected', c.id === selected));
		};

		const step = (dir: 1 | -1) => {
			if (!lot.length) return;
			const i = lot.findIndex((c) => c.id === selected);
			select(lot[(i + dir + lot.length) % lot.length].id);
		};

		const renderCar = (car: Car) => {
			const ready = car.jobs.length === 0;
			car.el.classList.toggle('ready', ready);
			car.el.dataset.next = car.jobs[0] ?? 'deliver';
			car.el.querySelector('.jobs')!.innerHTML = ready
				? '<span class="job done">🚀 Ship it</span>'
				: car.jobs.map((j, i) => `<span class="job${i ? '' : ' next'}" title="${JOBS[j].label}">${JOBS[j].badge}</span>`).join('');
			const needs = ready ? 'ready to ship' : `next: ${car.jobs.map((j) => JOBS[j].label.toLowerCase()).join(', then ')}`;
			car.el.querySelector('button')!.setAttribute('aria-label', `${car.vip ? 'Incident ' : 'Ticket '}${car.plate}: ${needs}`);
		};

		const toLot = (car: Car) => {
			lot.push(car);
			car.el.classList.remove('out-good', 'out-bad', 'selected', 'urgent');
			list.appendChild(car.el);
			renderCar(car);
			if (selected === null) select(car.id);
			hud();
		};

		const leaveLot = (car: Car, cls: string, keep = false) => {
			lot = lot.filter((c) => c !== car);
			car.el.classList.remove('selected', 'urgent');
			car.el.classList.add(cls);
			if (!keep) setTimeout(() => car.el.remove(), 380);
			else setTimeout(() => !lot.includes(car) && car.el.remove(), 380);
			if (selected === car.id) select(null);
			hud();
		};

		const loseLife = (why: string) => {
			lives--;
			combo = 1;
			stats.missed++;
			root.classList.remove('hurt');
			void root.offsetWidth;
			root.classList.add('hurt');
			toast(why, 'bad');
			hud();
			if (lives <= 0) end(false);
		};

		const spawn = () => {
			const h = hour();
			if (lot.length >= CAPACITY) {
				loseLife('Backlog full, ops escalated 🚧');
				return;
			}
			const r = Math.random();
			const pFire = h >= 10 ? 0.1 : 0;
			const pFeature = h < 10 ? 0.2 : 0.32;
			const type = r < pFire ? 'incident' : r < pFire + pFeature ? 'feature' : r < pFire + pFeature + 0.2 ? 'idea' : 'bug';
			const ticket = TICKETS[type];
			const jobs = [...ticket.jobs];
			const n = jobs.length;
			const vip = type === 'incident';
			const max = (9000 + 1500 * n) * (vip ? 0.7 : 1);
			const el = document.createElement('li');
			el.className = vip ? 'car vip' : 'car';
			const id = nextId++;
			const car: Car = { id, jobs, total: n, vip, plate: plate(), patience: max, max, el };
			el.innerHTML = `
				<button type="button" class="car-btn">
					<span class="car-body" style="--car:${pick(COLORS)}">${ticket.icon}</span>
					<span class="car-info"><span class="tk"><span class="plate mono">${car.plate}</span><span class="ttl">${pick(ticket.titles)}</span></span><span class="jobs"></span></span>
					<span class="timer"><span class="timer-fill"></span></span>
				</button>`;
			el.querySelector('button')!.addEventListener('click', () => select(id));
			toLot(car);
		};

		const renderBay = (bay: Bay) => {
			const slots = bay.el.querySelectorAll<HTMLElement>('.slot');
			slots.forEach((s, i) => {
				const job = bay.slots[i];
				s.classList.toggle('busy', !!job);
				s.title = job ? job.car.plate : 'free';
				s.querySelector<HTMLElement>('.slot-fill')!.style.transform = `scaleX(${job ? 1 - job.left / bay.time : 0})`;
			});
			bay.el.classList.toggle('full', bay.slots.length >= bay.size);
		};

		const mistake = (btn: HTMLElement | null, text: string) => {
			score = Math.max(0, score - 5);
			combo = 1;
			stats.mistakes++;
			flash(btn, 'flash-bad');
			toast(text, 'bad');
			hud();
		};

		const route = (kind: Kind) => {
			if (!playing) return;
			const car = lot.find((c) => c.id === selected);
			if (!car) return;
			const btn = root.querySelector<HTMLElement>(`[data-route="${kind}"]`);
			if (kind === 'deliver') {
				if (car.jobs.length) return mistake(btn, `Not done: needs ${car.jobs.map((j) => JOBS[j].badge).join('')}`);
				const gained = (10 + 10 * car.total) * combo * (car.vip ? 2 : 1);
				score += gained;
				stats.delivered++;
				combo = Math.min(5, combo + 1);
				stats.bestCombo = Math.max(stats.bestCombo, combo);
				flash(btn, 'flash-good');
				toast(`+${gained}${car.vip ? ' 🔥' : ''}`, 'good');
				leaveLot(car, 'out-good');
				return;
			}
			if (car.jobs[0] !== kind) {
				return mistake(btn, car.jobs.includes(kind) ? `${JOBS[car.jobs[0]].badge} ${JOBS[car.jobs[0]].label} it first −5` : `Doesn't need ${JOBS[kind].badge} −5`);
			}
			const bay = bays[kind];
			if (bay.slots.length >= bay.size) {
				flash(btn, 'flash-bad');
				toast(kind === 'review' ? `Still reviewing ⏳` : `${JOBS[kind].badge} all slots busy ⏳`, 'bad');
				return;
			}
			bay.slots.push({ car, left: bay.time });
			flash(btn, 'flash-good');
			leaveLot(car, 'out-good', true);
			renderBay(bay);
		};

		const tick = (now: number) => {
			if (!playing) return;
			// Clamp so a backgrounded tab doesn't fast-forward the shift.
			const dt = lastTick ? Math.min(100, now - lastTick) : 0;
			lastTick = now;
			if (visible) {
				elapsed += dt;
				const h = hour();
				clockEl.textContent = fmtClock(Math.min(h, START_HOUR + HOURS));
				shiftFill.style.transform = `scaleX(${Math.min(1, elapsed / SHIFT_MS)})`;
				if (eventIdx < EVENTS.length && h >= EVENTS[eventIdx].at) showBanner(EVENTS[eventIdx++].text);
				if (elapsed >= SHIFT_MS) return end(true);

				spawnIn -= dt;
				if (spawnIn <= 0) {
					spawn();
					if (!playing) return;
					const base = 2400;
					spawnIn = base * (0.8 + Math.random() * 0.4);
				}

				for (const bay of Object.values(bays)) {
					for (const job of [...bay.slots]) {
						job.left -= dt;
						if (job.left <= 0) {
							bay.slots = bay.slots.filter((j) => j !== job);
							const car = job.car;
							car.jobs = car.jobs.filter((j) => j !== bay.kind);
							car.patience = Math.min(car.max, car.patience + 2500);
							toLot(car);
						}
					}
					renderBay(bay);
				}

				for (const car of [...lot]) {
					car.patience -= dt;
					const left = car.patience / car.max;
					car.el.querySelector<HTMLElement>('.timer-fill')!.style.transform = `scaleX(${Math.max(0, left)})`;
					car.el.classList.toggle('urgent', left < 0.3);
					if (left <= 0) {
						leaveLot(car, 'out-bad');
						loseLife(`${car.plate} got escalated ⏰`);
						if (!playing) return;
					}
				}
			}
			requestAnimationFrame(tick);
		};

		const start = () => {
			lot.forEach((c) => c.el.remove());
			list.innerHTML = '';
			Object.values(bays).forEach((b) => {
				b.slots = [];
				renderBay(b);
			});
			lot = [];
			selected = null;
			score = 0;
			combo = 1;
			lives = 3;
			elapsed = 0;
			lastTick = 0;
			spawnIn = 300;
			eventIdx = 0;
			stats = { delivered: 0, missed: 0, mistakes: 0, bestCombo: 1 };
			playing = true;
			overlay.hidden = true;
			banner.hidden = true;
			clockEl.textContent = '08:00';
			hud();
			requestAnimationFrame(tick);
		};

		const end = (survived: boolean) => {
			playing = false;
			const bonus = survived ? lives * 25 : 0;
			score += bonus;
			hud();
			const isBest = score > best;
			if (isBest) {
				best = score;
				try {
					localStorage.setItem('shipit-best', String(best));
				} catch (e) {}
				bestEl.textContent = String(best);
			}
			const stars = survived ? STARS.filter((s) => score >= s).length : 0;
			if (stars === 3) window.dispatchEvent(new CustomEvent('egg', { detail: 'stars' }));
			const verdict = !survived
				? `Pulled into a meeting at ${fmtClock(hour())}. Too many escalations. 😬`
				: ['You made it. Barely. Tomorrow will be better.', 'Solid day. Ops is happy. 🚀', 'Shipped it all. Ops is impressed.', 'Ops wants to clone you. 🏆'][stars];
			$('[data-overlay-title]').textContent = !survived ? 'Shift over' : isBest && score > 0 ? `New best: ${score}!` : 'Shift complete!';
			$('[data-overlay-body]').innerHTML = `
				${survived ? `<div class="stars" aria-label="${stars} of 3 stars">${'★'.repeat(stars)}<span>${'★'.repeat(3 - stars)}</span></div>` : ''}
				<p class="verdict">${verdict}</p>
				<dl class="end-stats">
					<div><dt>Score</dt><dd>${score}</dd></div>
					<div><dt>Shipped</dt><dd>${stats.delivered}</dd></div>
					<div><dt>Escalated</dt><dd>${stats.missed}</dd></div>
					<div><dt>Best combo</dt><dd>×${stats.bestCombo}</dd></div>
					${bonus ? `<div><dt>Hearts bonus</dt><dd>+${bonus}</dd></div>` : ''}
					<div><dt>Mistakes</dt><dd>${stats.mistakes}</dd></div>
				</dl>
				${survived && stars < 3 ? `<p class="next">Next star at ${STARS[stars]}.</p>` : ''}`;
			$('[data-start]').textContent = 'Another shift ↻';
			overlay.hidden = false;
		};

		$('[data-start]').addEventListener('click', start);
		root.querySelectorAll<HTMLButtonElement>('[data-route]').forEach((b) => b.addEventListener('click', () => route(b.dataset.route as Kind)));

		document.addEventListener('keydown', (e) => {
			if (!playing || !visible) return;
			const t = e.target as HTMLElement;
			if (t.closest('input, textarea, [data-terminal]')) return;
			const i = ['1', '2', '3', '4'].indexOf(e.key);
			if (i >= 0) {
				e.preventDefault();
				route(ORDER[i]);
			} else if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
				e.preventDefault();
				step(e.key === 'ArrowUp' ? -1 : 1);
			}
		});

		new IntersectionObserver(([entry]) => (visible = entry.isIntersecting), { threshold: 0.35 }).observe(root);

		// Lets the terminal's `play` command start a game.
		window.addEventListener('dispatch:start', () => {
			root.scrollIntoView({ behavior: 'smooth', block: 'center' });
			if (!playing) start();
		});
	}
</script>

<style>
	.dispatch {
		position: relative;
		padding: 18px;
		overflow: hidden;
	}
	.dispatch:global(.hurt) {
		animation: hurt 0.35s;
	}
	@keyframes hurt {
		25% {
			transform: translateX(-6px);
		}
		75% {
			transform: translateX(6px);
		}
	}
	.hud {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px 22px;
		font: 500 14px/1 var(--font-mono);
		padding-bottom: 14px;
		border-bottom: 2px dashed var(--ink);
		margin-bottom: 16px;
	}
	.hud b {
		font-weight: 700;
		color: var(--accent);
	}
	.clock {
		display: inline-flex;
		align-items: center;
		gap: 10px;
	}
	.clock b {
		font-size: 18px;
		color: var(--ink);
		background: var(--yellow);
		color: #151312;
		border: 2px solid var(--ink);
		border-radius: 8px;
		padding: 4px 8px;
	}
	.shift-bar {
		width: 90px;
		height: 8px;
		border: 2px solid var(--ink);
		border-radius: 99px;
		overflow: hidden;
	}
	.shift-bar span {
		display: block;
		height: 100%;
		background: var(--blue);
		transform: scaleX(0);
		transform-origin: left;
	}
	.lives {
		letter-spacing: 2px;
	}
	.board {
		display: grid;
		grid-template-columns: 1.35fr 1fr;
		gap: 16px;
	}
	.lot-head {
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--muted);
		display: flex;
		justify-content: space-between;
		margin-bottom: 8px;
	}
	.lot-head :global(.full) {
		color: var(--accent);
		font-weight: 700;
	}
	.cars {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 8px;
		min-height: 336px;
		align-content: start;
	}
	.cars :global(.car) {
		animation: slide-in 0.3s cubic-bezier(0.2, 1.4, 0.4, 1) both;
	}
	.cars :global(.car-btn) {
		width: 100%;
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: auto auto;
		column-gap: 12px;
		align-items: center;
		text-align: left;
		font: inherit;
		color: var(--ink);
		background: var(--paper);
		border: 2px solid var(--ink);
		border-radius: 12px;
		padding: 8px 12px;
		cursor: pointer;
	}
	.cars :global(.vip .car-btn) {
		border-color: var(--accent);
		border-style: dashed;
	}
	.cars :global(.ready .car-btn) {
		background: color-mix(in srgb, var(--green) 18%, var(--paper));
	}
	.cars :global(.selected .car-btn) {
		background: var(--yellow);
		color: #151312;
		box-shadow: 3px 3px 0 var(--ink);
		transform: translate(-2px, -2px);
