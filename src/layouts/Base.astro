---
import '../styles/global.css';
import Eggs from '../components/Eggs.astro';
import Terminal from '../components/Terminal.astro';
import { EMAIL, GITHUB, LINKEDIN, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	type?: 'website' | 'article';
}

const { title, description = SITE_DESCRIPTION, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · Product Engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/assets/avatar.png', Astro.site);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Mohammed Faour" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} · Blog`} href="/rss.xml" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			try {
				const t = localStorage.getItem('theme');
				if (t) document.documentElement.setAttribute('data-theme', t);
			} catch (e) {}
		</script>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<nav class="nav" aria-label="Main">
			<div class="wrap nav-inner">
				<a class="brand" href="/">
					<span class="brand-mark">MF</span>
					<span class="brand-name">mohammed<span>.</span>faour</span>
				</a>
				<div class="nav-links">
					<a href="/#work" class="hide-sm">Work</a>
					<a href="/#play">Play</a>
					<a href="/blog/" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Blog</a>
					<button class="icon-btn" type="button" data-open-terminal aria-label="Open terminal (press / key)" aria-keyshortcuts="/" title="Terminal ( / )">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 7 5 5-5 5M12 18h7"/></svg>
					</button>
					<button class="icon-btn" type="button" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle theme">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
					</button>
				</div>
			</div>
		</nav>

		<main id="main">
			<slot />
		</main>

		<footer class="footer">
			<div class="wrap footer-inner">
				<div>
					<strong class="footer-name">Mohammed Faour</strong>
					<span class="muted">Product engineer · Munich</span>
				</div>
				<div class="footer-links">
					<a href={`mailto:${EMAIL}`}>Email</a>
					<a href={LINKEDIN} rel="me noopener" target="_blank">LinkedIn</a>
					<a href={GITHUB} rel="me noopener" target="_blank">GitHub</a>
					<a href="/rss.xml">RSS</a>
				</div>
				<p class="footer-note muted">
					© <span id="footer-year">{new Date().getFullYear()}</span> · Built with Astro, hosted on GitHub Pages · press <kbd>/</kbd> for a terminal
				</p>
				<Eggs />
			</div>
		</footer>

		<Terminal />

		<script>
			const root = document.documentElement;
			document.getElementById('theme-toggle')?.addEventListener('click', () => {
				const current =
					root.getAttribute('data-theme') ||
					(matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				const next = current === 'dark' ? 'light' : 'dark';
				root.setAttribute('data-theme', next);
				try {
					localStorage.setItem('theme', next);
				} catch (e) {}
			});
			const year = document.getElementById('footer-year');
			if (year) year.textContent = String(new Date().getFullYear());
		</script>
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: -9999px;
	}
	.skip:focus {
		left: 12px;
		top: 12px;
		z-index: 100;
		background: var(--yellow);
		color: #151312;
		padding: 8px 12px;
		border: 2px solid var(--ink);
		border-radius: 8px;
	}
	.nav {
		position: sticky;
		top: 0;
		z-index: 40;
		background: color-mix(in srgb, var(--paper) 88%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 2px solid var(--ink);
	}
	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 64px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
	}
	.brand-mark {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 10px;
		background: var(--accent);
		color: var(--on-accent);
		border: 2px solid var(--ink);
		font: 800 14px/1 var(--font-display);
		box-shadow: 2px 2px 0 var(--ink);
		transition: transform 0.2s;
	}
	.brand:hover .brand-mark {
		transform: rotate(-8deg) scale(1.06);
	}
	.brand-name {
		font: 700 17px/1 var(--font-display);
		letter-spacing: -0.02em;
	}
	.brand-name span {
		color: var(--accent);
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 4px;
	}
	.nav-links a {
		text-decoration: none;
		font-weight: 600;
		font-size: 15px;
		padding: 8px 12px;
		border-radius: 10px;
	}
	.nav-links a:hover,
	.nav-links a[aria-current='page'] {
		background: var(--yellow);
		color: #151312;
	}
	.icon-btn {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		margin-left: 4px;
		border: 2px solid var(--ink);
		border-radius: 10px;
		background: var(--card);
		color: var(--ink);
		cursor: pointer;
		box-shadow: 2px 2px 0 var(--ink);
	}
	.icon-btn:hover {
		background: var(--yellow);
		color: #151312;
	}
	.icon-btn svg {
		width: 18px;
		height: 18px;
	}
	@media (max-width: 600px) {
		.hide-sm,
		.brand-name {
			display: none;
		}
	}

	.footer {
		border-top: 2px solid var(--ink);
		background: var(--card);
		padding: 40px 0 48px;
		margin-top: 40px;
	}
	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 16px 32px;
	}
	.footer-name {
		font: 800 20px/1.2 var(--font-display);
		display: block;
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
		font-weight: 600;
	}
	.footer-links a {
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}
	.footer-links a:hover {
		color: var(--accent);
	}
	.footer-note {
		width: 100%;
		margin: 8px 0 0;
		font-size: 14px;
	}
	kbd {
		font: 600 12px/1 var(--font-mono);
		padding: 3px 6px;
		border: 1.5px solid var(--ink);
		border-bottom-width: 3px;
		border-radius: 6px;
		background: var(--paper);
	}
</style>
